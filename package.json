{
  "name": "@tearoom1/meta-kit",
  "version": "1.5.5",
  "type": "module",
  "description": "AI-powered SEO plugin for Kirby with meta descriptions, previews, and Schema.org",
  "scripts": {
    "dev": "kirbyup js/index.js --watch",
    "build": "kirbyup js/index.js",
    "test:js": "node --test tests-js/*.test.js",
    "test:all": "composer test && pnpm run test:js"
  },
  "keywords": [
    "kirby",
    "seo",
    "ai",
    "opengraph"
  ],
  "author": "TearoomOne",
  "license": "MIT",
  "devDependencies": {
    "kirbyup": "4.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
